test-results/
playwright-report/
playwright-report-products/
# Playwright MCP scratch output (page snapshots, console logs, screenshots)
# from driving the app in a browser during development. 177 of these had
# accumulated untracked in a worktree, one `git add -A` away from the repo.
# Test baselines must never live here — see
# crates/impresspress-web/tests/playwright.config.ts.
.playwright-mcp/
# Playwright globalSetup writes a real session token here (see
# crates/impresspress-web/tests/e2e/fixtures/global-setup.ts). Never commit.
crates/impresspress-web/tests/.auth/

# Env
.env
.env.*
.dev.vars
.wrangler-dev.toml

# Wrangler
.wrangler/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Build output
build/
.bin/
# Local demo work
/demo/
/examples/products/clawfood/
/examples/tests/products-examples.spec.ts-snapshots/clawfood-*.png

# Git worktrees
.worktrees/
# Claude Code creates its worktrees under .claude/worktrees/, each with its
# own target/ (tens of GB); its per-machine settings live beside them.
.claude/worktrees/
.claude/settings.local.json

# Package locks should be committed for reproducible builds

# wasm-pack build output (generated by build.rs; self-inits a git repo)
/crates/impresspress-web/pkg/
# The `browser-devtools` wasm-pack output examples/dev-sandbox/build.sh
# builds into place — same as pkg/, just the feature-on twin.
/crates/impresspress-web/pkg-dev/
