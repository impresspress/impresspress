#!/usr/bin/env bash
set -euo pipefail

# Mirrors the checks CI's `check` job runs, so a commit that passes here passes
# there. That job lives in .github/workflows/ci-shared.yml, the one body both
# `ci.yml` (pull requests) and `ci-main.yml` (merges) call; the callers hold no
# job bodies of their own.
#
#   - rustfmt on the NIGHTLY toolchain. rustfmt.toml uses
#     `imports_granularity` / `group_imports`, which stable rustfmt silently
#     ignores, so a stable `cargo fmt` here produced files that CI's
#     `cargo +nightly fmt --check` then rejected.
#   - clippy over the same crate set and flags as CI: the host crates, with
#     the wasm-only impresspress-web / impresspress-cloudflare excluded
#     (they are compile-checked for wasm32 separately).
#
# Install once with:  git config core.hooksPath .githooks

# ── Rust: fmt + clippy on staged .rs files ──────────────────────────
RS_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
if [ -n "$RS_FILES" ]; then
  echo "Running cargo +nightly fmt..."
  cargo +nightly fmt --all
  git add $RS_FILES

  echo "Running cargo clippy --fix (CI's crate set and flags)..."
  cargo clippy --locked --workspace \
    --exclude impresspress-web --exclude impresspress-cloudflare \
    --fix --allow-dirty --allow-staged
  git add $RS_FILES
fi

# ── JS/TS: prettier on staged files ─────────────────────────────────
JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.ts' '*.tsx' '*.jsx' '*.css')
if [ -n "$JS_FILES" ]; then
  # Find prettier: the SDK package's devDependency, or one on PATH.
  PRETTIER="$(git rev-parse --show-toplevel)/packages/impresspress-js/node_modules/.bin/prettier"
  if [ ! -x "$PRETTIER" ]; then
    PRETTIER="$(command -v prettier 2>/dev/null || echo "")"
  fi
  if [ -n "$PRETTIER" ]; then
    echo "Running prettier --write..."
    echo "$JS_FILES" | xargs "$PRETTIER" --write
    git add $JS_FILES
  fi
fi

echo "✓ Pre-commit checks passed."
