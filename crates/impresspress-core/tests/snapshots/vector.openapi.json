{
  "components": {
    "schemas": {}
  },
  "paths": {
    "/b/vector/api/embed": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/vector/api/embed` request body.",
                "properties": {
                  "model": {
                    "description": "Embedding model id. Omitted means the catalog's default model.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "texts": {
                    "description": "Texts to embed; one vector is returned per text, in order. May be\nempty.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "texts"
                ],
                "title": "EmbedRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "`POST /b/vector/api/embed` response body.",
                  "properties": {
                    "dimensions": {
                      "description": "Vector dimensionality.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "model": {
                      "description": "Embedding model that produced the vectors.",
                      "type": "string"
                    },
                    "vectors": {
                      "description": "One vector per input text, in input order.",
                      "items": {
                        "items": {
                          "format": "float",
                          "type": "number"
                        },
                        "type": "array"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "model",
                    "dimensions",
                    "vectors"
                  ],
                  "title": "EmbedResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Generate embeddings for raw text"
      }
    },
    "/b/vector/api/indexes": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "`GET /b/vector/api/indexes` response body.",
                  "properties": {
                    "indexes": {
                      "description": "Index names, in lexical order. Empty when no vector backend is\navailable on this deployment.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "indexes"
                  ],
                  "title": "IndexListResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List indexes"
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/vector/api/indexes` request body.",
                "properties": {
                  "dimensions": {
                    "description": "Consistency check only: when given it must equal the model's own\ndimensionality, which is what the index is created with either way.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "keyword_search": {
                    "default": false,
                    "description": "Also store text for keyword and hybrid search.",
                    "type": "boolean"
                  },
                  "metric": {
                    "anyOf": [
                      {
                        "description": "Distance metric a vector index is built with. Mirrors\n`wafer_core::clients::vector::DistanceMetric`.",
                        "oneOf": [
                          {
                            "const": "cosine",
                            "description": "Cosine similarity.",
                            "type": "string"
                          },
                          {
                            "const": "euclidean",
                            "description": "Euclidean (L2) distance.",
                            "type": "string"
                          },
                          {
                            "const": "dotproduct",
                            "description": "Dot product.",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Distance metric. Omitted means `cosine`."
                  },
                  "model": {
                    "description": "Embedding model id from the catalog. Omitted means the catalog's\ndefault model.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "description": "Index name: `[A-Za-z0-9_]` only. Every other endpoint addresses the\nindex by this name.",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "title": "CreateIndexRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "`POST /b/vector/api/indexes` response body: the configuration the index\nwas created with, after model and metric defaults were applied.\n\nOnly for JSON callers. The admin modal posts the same endpoint with an\n`HX-Request` header and receives the refreshed index list as HTML.",
                  "properties": {
                    "dimensions": {
                      "description": "Vector dimensionality, taken from the model.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "keyword_search": {
                      "description": "Whether the index also stores text for keyword and hybrid search.",
                      "type": "boolean"
                    },
                    "metric": {
                      "description": "Distance metric the index was created with.",
                      "oneOf": [
                        {
                          "const": "cosine",
                          "description": "Cosine similarity.",
                          "type": "string"
                        },
                        {
                          "const": "euclidean",
                          "description": "Euclidean (L2) distance.",
                          "type": "string"
                        },
                        {
                          "const": "dotproduct",
                          "description": "Dot product.",
                          "type": "string"
                        }
                      ]
                    },
                    "model": {
                      "description": "Embedding model id the index is bound to.",
                      "type": "string"
                    },
                    "name": {
                      "description": "The name the index is addressed by.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "model",
                    "dimensions",
                    "metric",
                    "keyword_search"
                  ],
                  "title": "CreateIndexResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a vector index"
      }
    },
    "/b/vector/api/indexes/{name}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Index name, as returned by `GET /b/vector/api/indexes`.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body of `DELETE /b/vector/api/indexes/{name}`,\n`POST /b/vector/api/upsert` and `DELETE /b/vector/api/{index}/{id}`.",
                  "properties": {
                    "ok": {
                      "description": "Always `true`: a write that did not happen is an error response.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "title": "AckResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Delete an index"
      }
    },
    "/b/vector/api/ingest": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/vector/api/ingest` request body: chunk a document, embed each\nchunk with the index's model and upsert the chunks. Re-ingesting the\nsame `document_id` replaces its previous chunks.",
                "properties": {
                  "contextual": {
                    "default": false,
                    "description": "Prepend an LLM-written one-paragraph summary of the document to every\nchunk before embedding. Silently skipped when no default LLM is\nconfigured.",
                    "type": "boolean"
                  },
                  "document_id": {
                    "description": "Caller-supplied document id. Chunk ids are `{document_id}:{n}`.",
                    "type": "string"
                  },
                  "index": {
                    "description": "Index name.",
                    "type": "string"
                  },
                  "metadata": {
                    "description": "Arbitrary JSON stored on every chunk as `user_metadata`, beside the\n`document_id` and `chunk_index` the block adds."
                  },
                  "text": {
                    "description": "The document text.",
                    "type": "string"
                  }
                },
                "required": [
                  "index",
                  "document_id",
                  "text"
                ],
                "title": "IngestRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "`POST /b/vector/api/ingest` response body.",
                  "properties": {
                    "chunks_created": {
                      "description": "Chunks written. `0` when the text was empty or whitespace only.",
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "chunks_created"
                  ],
                  "title": "IngestResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Chunk + embed + upsert a document"
      }
    },
    "/b/vector/api/query": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/vector/api/query` request body. At least one of `text` and\n`vector` is required. With `vector` alone it is the query vector as is;\nwith `text` alone the text is embedded with the index's own model. When\nboth are present `vector` is used as is and `text` is not embedded — it\nthen serves only as the keyword-query fallback in keyword and hybrid\nmode.",
                "properties": {
                  "filter": {
                    "description": "Restrict hits to rows whose metadata matches.",
                    "properties": {
                      "equals": {
                        "additionalProperties": true,
                        "default": {},
                        "description": "Equality constraints: each key is a dot-path into the stored metadata\nand the value must match exactly.",
                        "type": "object"
                      }
                    },
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "index": {
                    "description": "Index name.",
                    "type": "string"
                  },
                  "keyword_query": {
                    "description": "Keyword query for keyword and hybrid mode. Omitted means `text`.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mode": {
                    "anyOf": [
                      {
                        "description": "Search modality. Mirrors `wafer_core::clients::vector::SearchMode`.",
                        "oneOf": [
                          {
                            "const": "vector",
                            "description": "Pure vector similarity search.",
                            "type": "string"
                          },
                          {
                            "const": "keyword",
                            "description": "Pure keyword (full-text) search.",
                            "type": "string"
                          },
                          {
                            "const": "hybrid",
                            "description": "Hybrid vector + keyword search.",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Search modality. Omitted means `hybrid` for an index created with\n`keyword_search`, `vector` otherwise."
                  },
                  "text": {
                    "description": "Query text. Embedded with the model the index was created with when\n`vector` is absent; never embedded when `vector` is present. In\nkeyword and hybrid mode it is also the keyword query unless\n`keyword_query` is given.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "top_k": {
                    "description": "Maximum number of hits. Omitted means 10.",
                    "format": "uint",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "vector": {
                    "description": "Pre-computed query vector, used as is; its length must match the\nindex's `dimensions`. When present, `text` is not embedded.",
                    "items": {
                      "format": "float",
                      "type": "number"
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "required": [
                  "index"
                ],
                "title": "QueryRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "`POST /b/vector/api/query` response body.",
                  "properties": {
                    "matches": {
                      "description": "Hits, best first.",
                      "items": {
                        "description": "One query hit. Mirrors `wafer_core::clients::vector::VectorMatch`.",
                        "properties": {
                          "id": {
                            "description": "Matched row id.",
                            "type": "string"
                          },
                          "metadata": {
                            "description": "The metadata stored with the row. Absent when the row stored none."
                          },
                          "score": {
                            "description": "Similarity score; its scale depends on the index's metric.",
                            "format": "float",
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "score"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "matches"
                  ],
                  "title": "QueryResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Search vectors"
      }
    },
    "/b/vector/api/stats": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "`GET /b/vector/api/stats` response body.",
                  "properties": {
                    "indexes": {
                      "description": "Every index, in lexical order. Empty when no vector backend is\navailable on this deployment.",
                      "items": {
                        "description": "One index with its row count.",
                        "properties": {
                          "count": {
                            "description": "Rows currently stored. `0` when the count could not be read.",
                            "format": "uint64",
                            "minimum": 0,
                            "type": "integer"
                          },
                          "name": {
                            "description": "Index name.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "count"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "indexes"
                  ],
                  "title": "IndexStatsResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Index stats and usage"
      }
    },
    "/b/vector/api/upsert": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "`POST /b/vector/api/upsert` request body.",
                "properties": {
                  "entries": {
                    "description": "Rows to insert or replace.",
                    "items": {
                      "description": "One row to upsert. Mirrors `wafer_core::clients::vector::VectorEntry`.",
                      "properties": {
                        "id": {
                          "description": "Caller-supplied row id. Upserting the same id again replaces the row.",
                          "type": "string"
                        },
                        "metadata": {
                          "description": "Arbitrary JSON metadata stored alongside the vector and echoed on\nquery hits."
                        },
                        "text": {
                          "description": "Text to index for keyword search. Required when the index was created\nwith `keyword_search`; ignored otherwise.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "vector": {
                          "description": "Embedding vector; its length must match the index's `dimensions`.",
                          "items": {
                            "format": "float",
                            "type": "number"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "id",
                        "vector"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "index": {
                    "description": "Index name.",
                    "type": "string"
                  }
                },
                "required": [
                  "index",
                  "entries"
                ],
                "title": "UpsertRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body of `DELETE /b/vector/api/indexes/{name}`,\n`POST /b/vector/api/upsert` and `DELETE /b/vector/api/{index}/{id}`.",
                  "properties": {
                    "ok": {
                      "description": "Always `true`: a write that did not happen is an error response.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "title": "AckResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Upsert pre-computed vectors"
      }
    },
    "/b/vector/api/{index}/{id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Row id, as supplied on upsert (or `{document_id}:{n}` for an ingested chunk).",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "index",
            "required": true,
            "schema": {
              "description": "Index name, as returned by `GET /b/vector/api/indexes`.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body of `DELETE /b/vector/api/indexes/{name}`,\n`POST /b/vector/api/upsert` and `DELETE /b/vector/api/{index}/{id}`.",
                  "properties": {
                    "ok": {
                      "description": "Always `true`: a write that did not happen is an error response.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "title": "AckResponse",
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Delete a single vector"
      }
    }
  }
}